PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/bookwise
JWT_SECRET=replace-this-with-a-private-random-secret-of-at-least-32-characters
CLIENT_ORIGIN=http://localhost:5173
RECOMMENDATION_URL=http://127.0.0.1:8000
# SMTP is optional for local email password recovery; required to send reset email in production.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=BookWise AI <noreply@example.com>
# First admin bootstrap only. After running npm run seed:admin, remove BOOTSTRAP_ADMIN_PASSWORD.
# BOOTSTRAP_ADMIN_NAME=Library Administrator
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=use-a-private-password-with-14-or-more-characters

